{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-coffee-deck",
  "compatibility_date": "2026-08-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "coffee-deck-auth-db",
      "database_id": "330a08ba-bb02-47ee-8e27-ede2d20163d7"
    }
  ],
  "vars": {
    "SITE_URL": "https://thecoffeedeck.net"
  }
}
